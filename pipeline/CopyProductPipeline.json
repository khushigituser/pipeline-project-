{
	"name": "CopyProductPipeline",
	"properties": {
		"activities": [
			{
				"name": "CheckIfCountMoreThan600",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greaterOrEquals(pipeline().parameters.customerCount, 600)\n",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "CopyProductData",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT * FROM Product\n",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_SQL_Product",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ProductOutput",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"customerCount": {
				"type": "int"
			}
		},
		"variables": {
			"customerCount": {
				"type": "Integer"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-06-30T14:14:21Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}