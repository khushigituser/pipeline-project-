{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "khushi-adf"
		},
		"AzureBlobStorageLS_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageLS'"
		},
		"LS_SQL_CustomerDB1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_CustomerDB1'"
		},
		"LS_SQL_CustomerDB1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "khushi-sql-server.database.windows.net"
		},
		"LS_SQL_CustomerDB1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ProductDB"
		},
		"LS_SQL_CustomerDB1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "khushi_admin"
		},
		"RestCountriesAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://restcountries.com/"
		},
		"trigger1_properties_CopyCustomerPipeline_parameters_customerCount": {
			"type": "int",
			"defaultValue": 508
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "khushi-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorageLS_connectionString": {
						"value": "[parameters('AzureBlobStorageLS_connectionString')]"
					},
					"LS_SQL_CustomerDB1_password": {
						"value": "[parameters('LS_SQL_CustomerDB1_password')]"
					},
					"LS_SQL_CustomerDB1_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_CustomerDB1_properties_typeProperties_server')]"
					},
					"LS_SQL_CustomerDB1_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_CustomerDB1_properties_typeProperties_database')]"
					},
					"LS_SQL_CustomerDB1_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_CustomerDB1_properties_typeProperties_userName')]"
					},
					"RestCountriesAPI_properties_typeProperties_url": {
						"value": "[parameters('RestCountriesAPI_properties_typeProperties_url')]"
					},
					"trigger1_properties_CopyCustomerPipeline_parameters_customerCount": {
						"value": "[parameters('trigger1_properties_CopyCustomerPipeline_parameters_customerCount')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}